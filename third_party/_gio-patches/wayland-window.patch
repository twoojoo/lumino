 //export gio_onToplevelConfigure
 func gio_onToplevelConfigure(data unsafe.Pointer, topLvl *C.struct_xdg_toplevel, width, height C.int32_t, states *C.struct_wl_array) {
 	w := callbackLoad(data).(*window)
+	// kubeon patch: track maximized/fullscreen state changes initiated by
+	// the compositor (keyboard shortcuts, drag-to-top, drag-to-restore).
+	maximized, fullscreen, activated := false, false, false
+	if states != nil && states.size > 0 {
+		n := int(states.size) / 4
+		for _, st := range unsafe.Slice((*C.uint32_t)(states.data), n) {
+			switch st {
+			case C.XDG_TOPLEVEL_STATE_MAXIMIZED:
+				maximized = true
+			case C.XDG_TOPLEVEL_STATE_FULLSCREEN:
+				fullscreen = true
+			case C.XDG_TOPLEVEL_STATE_ACTIVATED:
+				activated = true
+			}
+		}
+	}
+	prevMode := w.config.Mode
+	switch {
+	case fullscreen:
+	case prevMode == Minimized:
+		// restored from the dock/overview
+		if activated {
+			w.config.Mode = Windowed
+			if maximized {
+				w.config.Mode = Maximized
+			}
+		}
+	case maximized:
+		if prevMode == Windowed {
+			w.wsize = w.config.Size
+			w.config.Mode = Maximized
+		}
+	default:
+		if prevMode == Maximized {
+			w.config.Mode = Windowed
+			if (width == 0 || height == 0) && w.wsize != (image.Point{}) {
+				w.size = w.wsize.Div(w.scale)
+				w.updateOpaqueRegion()
+			}
+		}
+	}
 	if width != 0 && height != 0 {
 		w.size = image.Pt(int(width), int(height))
 		w.updateOpaqueRegion()
 	}
+	if w.config.Mode != prevMode {
+		w.ProcessEvent(ConfigEvent{Config: w.config})
+	}
 }
 
